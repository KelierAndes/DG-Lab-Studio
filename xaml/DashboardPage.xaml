<?xml version="1.0" encoding="utf-8"?>
<Page
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled"
                HorizontalScrollBarVisibility="Disabled" Padding="40,0,40,40">
    <StackPanel Spacing="14">

      <StackPanel x:Name="HeadHost" />

      <Grid x:Name="StatsHost" ColumnSpacing="14" />

      <Grid ColumnSpacing="14">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="1*" />
          <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>
        <ContentControl
            x:Name="InputChannelsHost"
            HorizontalContentAlignment="Stretch"
            VerticalContentAlignment="Stretch" />
        <ContentControl
            x:Name="OutputChannelsHost"
            Grid.Column="1"
            HorizontalContentAlignment="Stretch"
            VerticalContentAlignment="Stretch" />
      </Grid>

      <StackPanel x:Name="DevicesHost" Spacing="10" />

    </StackPanel>
  </ScrollViewer>
</Page>
