<?xml version="1.0" encoding="utf-8"?>
<Page
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Page.Resources>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
      <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8,8,8,8" />
      <Setter Property="Padding" Value="16,16,16,16" />
    </Style>
  </Page.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled"
                HorizontalScrollBarVisibility="Disabled" Padding="40,0,40,40">
    <StackPanel Spacing="14">

      <StackPanel x:Name="HeadHost" />

      <Border Style="{StaticResource Card}" Padding="16,12,16,12">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel x:Name="FilterHost" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" />
          <StackPanel x:Name="ToolsHost" Grid.Column="1" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center" />
        </Grid>
      </Border>

      <Border Style="{StaticResource Card}" Padding="16,16,16,4">
        <StackPanel>
          <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="运行日志" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
            <TextBlock
                x:Name="CountText"
                Grid.Column="1"
                FontSize="12"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
          </Grid>
          <Grid Height="32" Margin="0,0,0,2">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="132" />
              <ColumnDefinition Width="76" />
              <ColumnDefinition Width="130" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="时间" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="等级" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" Margin="12,0,0,0" />
            <TextBlock Grid.Column="2" Text="来源" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" Margin="12,0,0,0" />
            <TextBlock Grid.Column="3" Text="内容" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" Margin="12,0,0,0" />
          </Grid>
          <StackPanel x:Name="LogHost" />
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>
</Page>
